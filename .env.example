# Produktion; lokal .env.local mit http://localhost:3000 verwenden
NEXT_PUBLIC_SITE_URL=https://webstudio-expert.de
# Öffentliche SEO-Domain, unabhängig von der aktuell genutzten CRM-Adresse
NEXT_PUBLIC_SEO_URL=https://webstudio-expert.de
# Optional: reine Verifizierungscodes aus Search Console / Bing, kein vollständiges HTML
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NEXT_PUBLIC_BRAND_NAME=Webstudio Expert
NEXT_PUBLIC_CONTACT_EMAIL=kontakt@webstudio-expert.de
NEXT_PUBLIC_PHONE=+49 155 67504871
# Echte Daten werden nachgereicht. Leere Felder deaktivieren automatischen Versand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=kontakt@webstudio-expert.de
INQUIRY_TO=kontakt@webstudio-expert.de
# Tatsächlichen Mailanbieter vor Aktivierung auch im Datenschutz benennen
MAIL_PROVIDER_NAME=
MAIL_PROVIDER_ADDRESS=
# Nur serverseitig hinterlegen. Lokales Geheimnis wurde in .env.local erzeugt.
FORM_SECRET=
# Nur bei tatsächlichem Vorliegen ergänzen; private Steuernummer nicht veröffentlichen
BUSINESS_VAT_ID=
BUSINESS_ECONOMIC_ID=
BUSINESS_REGISTER=

# CRM: neues Supabase-Projekt, Migrationen aus supabase/migrations/ ausführen
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRM_ADMIN_EMAIL=kontakt@webstudio-expert.de
# Nur für die einmalige Kontoanlage; danach entfernen
CRM_BOOTSTRAP_PASSWORD=
# node scripts/crm-secrets.mjs erzeugt lokale Werte; auf Vercel serverseitig setzen
CRM_ENCRYPTION_KEY=
CRON_SECRET=
NEXT_PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
# Alternativ zu verschlüsselten Integration-Einstellungen im CRM
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
# Optionaler OpenAI-kompatibler Leseassistent; keine Schreibwerkzeuge
CRM_AI_BASE_URL=
CRM_AI_API_KEY=
CRM_AI_MODEL=

# Kostenloser OSM-Importer: optional, Standard-Endpunkte funktionieren ohne API-Key
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSM_GEOCODER_URL=https://nominatim.openstreetmap.org/search
